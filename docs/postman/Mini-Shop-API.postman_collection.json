              }
            ],
            "description": "Login User. Permissions/status/schema: docs/api.md.",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"user@minishop.test\",\n  \"password\": \"DemoShop2026!\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [
            {
              "name": "200 example",
